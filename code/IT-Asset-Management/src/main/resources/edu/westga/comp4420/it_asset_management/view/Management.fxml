<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="560.0" prefWidth="920.0" spacing="12.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.westga.comp4420.it_asset_management.view.ManagementWindowController">
    <padding>
        <Insets bottom="18.0" left="18.0" right="18.0" top="18.0" />
    </padding>

    <Label style="-fx-font-size: 22px; -fx-font-weight: bold;" text="Inventory Management Dashboard" />
    <Label text="Manage devices by type, user group, department, and building." />

    <HBox spacing="10.0">
        <Label text="Device Type:" />
        <ComboBox fx:id="deviceTypeFilter" prefWidth="150.0" />

        <Label text="User Type:" />
        <ComboBox fx:id="userTypeFilter" prefWidth="130.0" />

        <Label text="Department:" />
        <ComboBox fx:id="departmentFilter" prefWidth="160.0" />

        <Label text="Building:" />
        <ComboBox fx:id="buildingFilter" prefWidth="140.0" />

        <Button mnemonicParsing="false" onAction="#onApplyFilters" text="Apply Filters" />
    </HBox>

    <TableView fx:id="deviceTable" prefHeight="390.0" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="deviceNameColumn" prefWidth="150.0" text="Device Name" />
            <TableColumn fx:id="deviceTypeColumn" prefWidth="145.0" text="Device Type" />
            <TableColumn fx:id="userTypeColumn" prefWidth="110.0" text="User Type" />
            <TableColumn fx:id="departmentColumn" prefWidth="150.0" text="Department" />
            <TableColumn fx:id="buildingColumn" prefWidth="130.0" text="Building" />
            <TableColumn fx:id="statusColumn" prefWidth="120.0" text="Status" />
        </columns>
    </TableView>

    <HBox spacing="10.0">
        <Button fx:id="addDeviceButton" mnemonicParsing="false" onAction="#onAddDevice" text="Add New Device" />
        <Button fx:id="editDeviceButton" mnemonicParsing="false" onAction="#onEditSelectedDevice" text="Edit Selected Device" />
        <Label fx:id="actionStatusLabel" maxWidth="1.7976931348623157E308" text="Select a device to edit or add a new device." wrapText="true" HBox.hgrow="ALWAYS" />
    </HBox>
</VBox>
